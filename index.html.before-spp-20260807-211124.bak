<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="BMSレーティングツール">
    <title>Stella Rating</title>
    <link rel="icon" href="SR_icon.png" type="image/png">
    <style>
        /* Previous: dark hero, decorative cards, feature tags, notes, and footer.
           Reason for removal: Match the original Stella_Rating and show only the two required choices. */
        body { font-family: sans-serif; max-width: 1100px; margin: 20px auto; padding: 0 10px; line-height: 1.6; color: #333; }
        .box { border: 2px dashed #ccc; padding: 20px; margin-bottom: 15px; background: #f9f9f9; border-radius: 5px; }
        .box:hover { border-color: #888; }
        h2 { margin-top: 0; }
        a.button { display: inline-block; padding: 10px 20px; color: white; font-size: 16px; text-decoration: none; border-radius: 4px; background: #007bff; }
        a.button:hover { background: #0056b3; }
        a.button:focus-visible { outline: 3px solid #333; outline-offset: 3px; }
    </style>
</head>
<body>
    <h1>Stella Rating</h1>

    <div class="box">
        <h2>Stella_Rating</h2>
        <a class="button" href="stella-rating.html">開く</a>
    </div>

    <div class="box">
        <h2>統合難易度レーティング</h2>
        <a class="button" href="unified-rating.html">開く</a>
    </div>
</body>
</html>
